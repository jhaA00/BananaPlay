# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string. Update the user/password for your machine.
DATABASE_URL=postgresql://localhost:5432/banana_game

# Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# Comma-separated list of allowed frontend origins.
CLIENT_ORIGIN=http://localhost:5173

# UOB Banana puzzle API
BANANA_API_URL=https://marcconrad.com/uob/banana/api.php
